          <span class="material-symbols-outlined text-[20px]">logout</span>
        </a>

        {{else}}
        <div class="flex items-center gap-4">
          <a href="/login"
            class="text-sm font-bold text-white hover:text-accent transition-colors">Log In</a>
          <a href="/register" class="nav-cta-link">Get
            Started</a>
        </div>
        {{/if}}
      </div>
    </div>
  </div>

  <!-- Mobile Menu Dropdown (Controlled by JS) -->
  <div
    class="mobile-menu mobile-menu-panel md:hidden fixed top-20 left-0 w-full transition-all duration-300 origin-top scale-y-0 opacity-0 invisible"
