    <div class="flex flex-col p-6 gap-4">
      {{#if currentUser}}
      <a href="/search"
        class="mobile-menu-link flex items-center gap-3 p-3 rounded-2xl transition-colors">
        <span class="material-symbols-outlined text-accent">search</span>
        <span class="font-bold text-white">Explore Skills</span>
      </a>
      <a href="/petitions/show"
        class="mobile-menu-link flex items-center gap-3 p-3 rounded-2xl transition-colors">
        <span class="material-symbols-outlined text-accent">campaign</span>
        <span class="font-bold text-white">Community Petitions</span>
      </a>
      <div class="h-px bg-white/10 my-2"></div>
      <a href="/profile/me"
        class="mobile-menu-link flex items-center gap-3 p-3 rounded-2xl transition-colors">
        <img src="{{currentUser.avatar}}" onerror="this.src='https://i.pravatar.cc/150?u={{currentUser.email}}'"
          class="w-8 h-8 rounded-full">
        <span class="font-bold text-white">My Profile</span>
      </a>
      <a href="/logout"
        class="flex items-center gap-3 p-3 rounded-2xl hover:bg-red-500/10 text-red-300 transition-colors">
        <span class="material-symbols-outlined">logout</span>
        <span class="font-bold">Sign Out</span>
      </a>
      {{else}}
      <a href="/login"
        class="mobile-menu-link w-full py-4 text-center font-bold text-white border border-white/10 rounded-full transition-colors">Log
        In</a>
      <a href="/register" class="nav-cta-link w-full text-center">Create
        Account</a>
      {{/if}}
    </div>
  </div>
</nav>
