<section class="profile-page">
  <div class="profile-grid">
    <aside class="profile-panel">
      <div class="profile-hero">
        <img src="https://i.pravatar.cc/150?u={{user.email}}" class="profile-avatar" alt="{{user.username}}">
        <h1 class="profile-name">{{user.username}}</h1>
        {{#if isUserLogged}}
          <p class="profile-email">{{user.email}}</p>
        {{/if}}
        <p class="profile-description">{{user.description}}</p>

        {{#if isUserLogged}}
          <div class="profile-actions">
            <a class="btn-surface" href="/edit">Edit profile</a>
          </div>
        {{/if}}
      </div>

      <div class="profile-chip-list">
        {{#each user.interests as |interest|}}
          <div class="profile-chip">
            <img src="{{categoryImage interest}}" alt="{{interest}}">
            <span>{{interest}}</span>
          </div>
        {{/each}}
      </div>
    </aside>

    <section class="profile-skills-panel">
      <div class="profile-section-header">
        <h2 class="profile-section-title">{{user.username}}'s skills</h2>
        {{#if isUserLogged}}
          <a class="btn-surface" href="/skills/new">New skill</a>
        {{/if}}
      </div>

      {{#if skills.length}}
        <div class="profile-skills-list">
          {{#each skills as |skill|}}
            <article class="profile-skill-card">
              <div>
                <p class="profile-skill-name">{{skill.name}}</p>
                <p class="profile-skill-category">{{skill.category}}</p>
                <p class="rate mb-0" data-rate="{{skill.averageRate}}">
                  <span class="star">&#9733;</span>
                  <span class="star">&#9733;</span>
                  <span class="star">&#9733;</span>
                  <span class="star">&#9733;</span>
                  <span class="star">&#9733;</span>
                </p>
              </div>
              <div class="profile-skill-actions">
                <a class="btn-surface" href="/detail/{{skill.id}}">View</a>
                {{#if ../isUserLogged}}
                  <a class="btn-surface" href="/skills/{{skill.id}}/edit">Edit</a>
                  <a class="btn-surface btn-danger-soft" href="/skills/{{skill.id}}/delete">Delete</a>
                {{/if}}
              </div>
            </article>
          {{/each}}
        </div>
      {{else}}
        <div class="profile-empty">
          <p>No skills published yet.</p>
        </div>
      {{/if}}
    </section>
  </div>
</section>
